# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — bắt buộc, lấy từ Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — CHỈ dùng ở server (webhook, script create-admin), KHÔNG BAO GIỜ expose ra client
SUPABASE_SERVICE_ROLE_KEY=

# Resend — gửi email (vé webinar, quà lead magnet)
RESEND_API_KEY=
RESEND_FROM=

# Telegram — alert admin real-time khi có lead/thanh toán mới
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Thanh toán — VietQR + webhook PayOS/Casso
PAYOS_API_KEY=
# Secret xác thực webhook /api/webhook/payment. Nếu để trống sẽ fallback dùng PAYOS_API_KEY.
PAYMENT_WEBHOOK_SECRET=
# Mã ngân hàng Napas, ví dụ: VCB, TCB, MB
NEXT_PUBLIC_VIETQR_BANK=
NEXT_PUBLIC_VIETQR_ACCOUNT=
NEXT_PUBLIC_VIETQR_NAME=

# Feature flag — chỉ set "true" SAU KHI đã bật Google OAuth provider thật trong Supabase Dashboard.
# Mặc định false/để trống: nút "Tiếp tục với Google" bị ẩn trên trang login/register.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
